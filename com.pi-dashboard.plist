<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS launchd 模板（占位符）。装到自己机器上时把 /Users/you 换成你的实际路径，
     或直接用 `./ctl.sh install`（它会读取本文件并加载到 ~/Library/LaunchAgents）。 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pi-dashboard</string>

    <key>ProgramArguments</key>
    <!-- WASM blast-radius flags (SDK-migration slice 8): the server runs under
         the no-wasm-tier-up / liftoff-only / wasm-lazy-compilation V8 flags.
         These are launch-time isolate flags applied to the node invocation
         inside start.sh (this target), NOT here (start.sh is a shell script,
         not node). The server logs the effective V8 flags on boot. -->
    <array>
        <string>/Users/you/pi-dashboard/start.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/you/pi-dashboard</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/you/.local/bin:/Users/you/.cargo/bin</string>
        <key>HOME</key>
        <string>/Users/you</string>
        <key>SHELL</key>
        <string>/bin/zsh</string>
        <key>PI_DASH_PORT</key>
        <string>7777</string>
        <key>BEDROCK_MANTLE_LOG_FILE</key>
        <string>/Users/you/Library/Logs/pi-dashboard/bedrock-mantle.log</string>
        <key>BEDROCK_MANTLE_EMPTY_DUMP_DIR</key>
        <string>/Users/you/Library/Logs/pi-dashboard/empty-dumps</string>
    </dict>

    <!-- Start on login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Always keep running — restart on any exit -->
    <key>KeepAlive</key>
    <true/>

    <!-- Wait 10 seconds before restarting after exit -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Logs -->
    <key>StandardOutPath</key>
    <string>/Users/you/Library/Logs/pi-dashboard/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/you/Library/Logs/pi-dashboard/stderr.log</string>
</dict>
</plist>