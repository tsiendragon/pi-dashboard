{
  "liveSessions": {
    "roots": ["/home/you", "/home/you/repos"],
    "repoRoots": ["/home/you/repos"],
    "disconnectGraceMs": 60000,
    "launch": {
      "command": "/home/you/pi-stack/pi/bin/pi",
      "args": [],
      "unsetEnv": [],
      "approve": true
    }
  },
  "repos": [
    {
      "id": "my-project",
      "path": "/home/you/repos/my-project",
      "name": "my-project",
      "tags": ["demo"],
      "pinned": true,
      "defaultBranch": "main"
    }
  ],
  "tasks": {
    "enabled": true,
    "defaultView": "execute",
    "journal": {
      "autoDetect": true,
      "roots": ["/home/you/repos/my-taskspace"],
      "enabled": true
    },
    "jiraBaseUrl": "https://your-org.atlassian.net/browse/",
    "lanes": [
      { "id": "long", "label": "长期", "match": { "kind": ["epic"] } },
      { "id": "short", "label": "短期", "match": { "kind": ["task"] } },
      { "id": "adhoc", "label": "临时", "match": { "kind": ["todo", "item"] } }
    ],
    "providers": [
      {
        "kind": "file",
        "id": "extra-tasks",
        "label": "额外任务清单",
        "enabled": true,
        "file": "/home/you/.pi/tasks/extra-tasks.json"
      },
      {
        "kind": "command",
        "id": "my-tracker",
        "label": "我的看板",
        "enabled": true,
        "command": ["/home/you/bin/my-tracker-tasks", "--json"],
        "cwd": "/home/you/repos/my-project",
        "timeoutMs": 20000
      }
    ]
  },
  "vault": {
    "path": "/home/you/notes",
    "dirs": {
      "daily": "Daily",
      "tasks": "TaskNotes/Tasks",
      "meetings": "Meeting Notes",
      "people": "People",
      "recipes": "Recipes"
    }
  }
}